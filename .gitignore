.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
proxy/certs/*
!proxy/certs/.gitkeep

